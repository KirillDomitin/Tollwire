# Production-настройки. Скопировать в .env.prod (он в .gitignore) и заполнить:
#   cp .env.prod.example .env.prod
# Запуск: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# DATABASE_URL, REDIS_URL и COOKIE_SECURE здесь не задаются — их собирает docker-compose.prod.yml.

# --- PostgreSQL ---
POSTGRES_USER=vpn_panel
POSTGRES_PASSWORD=change_me   # openssl rand -hex 32 (только [0-9a-f]: пароль подставляется в URL)
POSTGRES_DB=vpn_panel

# --- Секреты приложения ---
JWT_SECRET_KEY=change_me      # openssl rand -hex 32
ENCRYPTION_KEY=change_me      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY нельзя менять после первого запуска: им зашифрованы SSH-учётки и VPN-конфиги в БД.

JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=2592000
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
LOG_LEVEL=info

# --- Планировщик (секунды; 0 — правило выключено) ---
SCHEDULER_ENABLED=true
ACCESS_RULES_INTERVAL_SECONDS=60
SESSION_CLEANUP_INTERVAL_SECONDS=3600
HEALTH_INTERVAL_SECONDS=600
SYNC_INTERVAL_SECONDS=3600
STALE_JOBS_INTERVAL_SECONDS=300
STALE_JOB_TIMEOUT_SECONDS=1800
REQUEUE_INTERVAL_SECONDS=300
REQUEUE_PENDING_AFTER_SECONDS=300
RETENTION_INTERVAL_SECONDS=86400
JOB_RETENTION_DAYS=90         # 0 — хранить вечно
AUDIT_RETENTION_DAYS=365      # 0 — хранить вечно

# --- Сеть и порты (необязательно) ---
# HTTP_PORT=80
# HTTPS_PORT=443
# EDGE_SUBNET=172.30.240.0/24  # сменить, если пересекается с сетями хоста
