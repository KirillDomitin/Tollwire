        safety_backup) printf '%s' "Safety backup of the current data: %s" ;;
        restore_stopping) printf '%s' "Stopping api and worker..." ;;
        restore_failed) printf '%s' "restore failed - the database was left as it was (single transaction), api and worker were started again. Safety backup: %s" ;;
        restore_migrating) printf '%s' "Applying migrations (in case the dump is older than the code)..." ;;
        restore_done) printf '%s' "Data restored from %s." ;;
        update_not_git) printf '%s' "this folder is not a git repository: update the code yourself and run ./panel update --no-pull." ;;
        update_dirty) printf '%s' "tracked files have local changes: commit or discard them, or use --no-pull." ;;
        update_pulling) printf '%s' "Updating the code (git pull --ff-only)..." ;;
        update_pull_failed) printf '%s' "git pull --ff-only failed: sort it out by hand or use --no-pull." ;;
        update_failed) printf '%s' "the update failed. Backup taken before it: %s. Get the data back with: ./panel restore %s ; logs: ./panel logs" ;;
        update_failed_nobackup) printf '%s' "the update failed (no backup was taken). Logs: ./panel logs" ;;
        update_done) printf '%s' "Update finished." ;;
        bad_service) printf '%s' "unknown service: %s (available: %s)" ;;
        cert_unknown) printf '%s' "unknown subcommand: %s (available: status, letsencrypt, renew)" ;;
        cert_missing) printf '%s' "certificate file not found: %s" ;;
        cert_file) printf '%s' "Certificate:   %s" ;;
        cert_issuer) printf '%s' "Issuer:        %s" ;;
        cert_valid) printf '%s' "Valid until:   %s (days left: %s)" ;;
        cert_covers) printf '%s' "Covers %s:  %s" ;;
        yes) printf '%s' "yes" ;;
        no) printf '%s' "no" ;;
        cert_le_managed) printf '%s' "Let's Encrypt: yes, renews automatically" ;;
        cert_not_le) printf '%s' "Let's Encrypt: no (self-signed or your own). Switch: ./panel cert letsencrypt" ;;
        cert_no_domain) printf '%s' "%s has no valid PANEL_DOMAIN - set the panel domain." ;;
        cert_renew_no_certbot) printf '%s' "the certificate is not from Let's Encrypt or certbot is not installed. Issue one: ./panel cert letsencrypt" ;;
