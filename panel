        bad_tail) printf '%s' "--tail must be a whole number of at least 0." ;;
        backup_failed) printf '%s' "pg_dump failed - no backup was created." ;;
        backup_invalid) printf '%s' "the dump is empty or damaged - no backup was created." ;;
        backup_done) printf '%s' "Backup created: %s (%s)." ;;
        backup_pruned) printf '%s' "Removed old backups: %s (the latest %s are kept)." ;;
        backup_key_reminder) printf '%s' "The dump is useless without ENCRYPTION_KEY from %s: keep a copy of %s away from this server." ;;
        restore_need_file) printf '%s' "give the backup file: ./panel restore FILE" ;;
        restore_no_file) printf '%s' "backup file not found: %s" ;;
        restore_not_dump) printf '%s' "%s is not a PostgreSQL dump (pg_dump -Fc); restore cancelled." ;;
        restore_need_terminal) printf '%s' "replacing the data needs confirmation: run in a terminal or add --yes." ;;
        restore_warning) printf '%s' "This will REPLACE all panel data (servers, users, access, audit log) with the contents of %s." ;;
        restore_prompt) printf '%s' "Type restore to continue: " ;;
