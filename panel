#!/usr/bin/env bash
# Обслуживание Tollwire (прод, Docker): резервные копии, восстановление, обновление, логи.
#
#   ./panel backup  [--keep N] [--dir DIR]
#   ./panel restore FILE [--yes] [--no-safety-backup]
#   ./panel update  [--no-backup] [--no-pull]
#   ./panel logs    [SERVICE...] [--tail N] [--no-follow]
#   ./panel cert    [status | letsencrypt [--email E] [--accept-le-terms] | renew]
#   ./panel bot     enable | disable | key [--remote] | revoke | status | invite ARGS…
#
# В бэкап попадает только дамп базы: ключ шифрования (ENCRYPTION_KEY из .env.prod) нарочно не кладётся рядом с
# данными — иначе тот, кто унесёт файл, получит и данные, и ключ к ним. Храните копию .env.prod отдельно.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

ENV_FILE=.env.prod
COMPOSE_FILE=docker-compose.prod.yml
DEFAULT_BACKUP_DIR=backups
DEFAULT_KEEP=14
DEFAULT_TAIL=100
SERVICES="nginx api worker postgres redis migrate bot"
CERT_DIR=certs
CERT_FILE=$CERT_DIR/fullchain.pem
KEY_FILE=$CERT_DIR/privkey.pem

# Язык сообщений, t, say и die — общее с ./install.sh.
# shellcheck source=deploy/common.sh
source deploy/common.sh
# shellcheck source=deploy/letsencrypt.sh
source deploy/letsencrypt.sh
# shellcheck source=deploy/bot.sh
source deploy/bot.sh

part_file=""
cleanup() {
    [ -z "$part_file" ] || rm -f "$part_file"
}
trap cleanup EXIT

# Сообщения: ключ → строка для printf (подстановки %s — по порядку, одинаковому в обоих языках).
msg_ru() {
    case $1 in
        unknown_command) printf '%s' "неизвестная команда: %s" ;;
        unknown_option) printf '%s' "неизвестный параметр: %s" ;;
        need_value) printf '%s' "после %s нужно значение." ;;
        no_docker) printf '%s' "Docker не найден." ;;
        docker_unreachable) printf '%s' "нет связи с Docker: демон не запущен или нет прав." ;;
        no_compose) printf '%s' "не найден плагин Docker Compose (команда 'docker compose')." ;;
        no_env) printf '%s' "не найден %s: сначала установите панель командой ./install.sh." ;;
        no_compose_file) printf '%s' "не найден %s: запускайте ./panel из корня репозитория." ;;
        postgres_down) printf '%s' "контейнер базы не запущен. Сначала запустите панель: ./install.sh" ;;
        bad_keep) printf '%s' "--keep — целое число не меньше 1." ;;
        bad_tail) printf '%s' "--tail — целое число не меньше 0." ;;
        backup_failed) printf '%s' "pg_dump завершился с ошибкой — бэкап не создан." ;;
        backup_invalid) printf '%s' "дамп пустой или повреждён — бэкап не создан." ;;
        backup_done) printf '%s' "Бэкап создан: %s (%s)." ;;
        backup_pruned) printf '%s' "Старые бэкапы удалены: %s (хранятся последние %s)." ;;
        backup_key_reminder) printf '%s' "Дамп бесполезен без ENCRYPTION_KEY из %s: храните копию %s отдельно от этого сервера." ;;
        restore_need_file) printf '%s' "укажите файл бэкапа: ./panel restore ФАЙЛ" ;;
        restore_no_file) printf '%s' "файл бэкапа не найден: %s" ;;
        restore_not_dump) printf '%s' "%s — не дамп PostgreSQL (pg_dump -Fc), восстановление отменено." ;;
        restore_need_terminal) printf '%s' "замена данных требует подтверждения: запустите в терминале или добавьте --yes." ;;
        restore_warning) printf '%s' "Это ЗАМЕНИТ все данные панели (серверы, пользователи, доступы, журнал) содержимым %s." ;;
        restore_prompt) printf '%s' "Введите restore, чтобы продолжить: " ;;
        restore_aborted) printf '%s' "Отменено, ничего не изменено." ;;
        safety_backup) printf '%s' "Страховочный бэкап текущих данных: %s" ;;
        restore_stopping) printf '%s' "Останавливаю api и worker…" ;;
        restore_failed) printf '%s' "восстановление не удалось — база осталась как была (одна транзакция), api и worker запущены снова. Страховочный бэкап: %s" ;;
        restore_migrating) printf '%s' "Применяю миграции (на случай, если дамп старше кода)…" ;;
        restore_done) printf '%s' "Данные восстановлены из %s." ;;
        update_not_git) printf '%s' "эта папка не git-репозиторий: обновите код сами и запустите ./panel update --no-pull." ;;
        update_dirty) printf '%s' "в отслеживаемых файлах есть локальные изменения: закоммитьте или отмените их, либо используйте --no-pull." ;;
        update_pulling) printf '%s' "Обновляю код (git pull --ff-only)…" ;;
        update_pull_failed) printf '%s' "git pull --ff-only не удался: разберитесь вручную или используйте --no-pull." ;;
        update_failed) printf '%s' "обновление не удалось. Бэкап перед обновлением: %s. Вернуть данные: ./panel restore %s ; логи: ./panel logs" ;;
        update_failed_nobackup) printf '%s' "обновление не удалось (бэкап не делался). Логи: ./panel logs" ;;
        update_done) printf '%s' "Обновление завершено." ;;
        bad_service) printf '%s' "неизвестный сервис: %s (доступны: %s)" ;;
        cert_unknown) printf '%s' "неизвестная подкоманда: %s (доступны: status, letsencrypt, renew)" ;;
        cert_missing) printf '%s' "файла сертификата нет: %s" ;;
        cert_file) printf '%s' "Сертификат:      %s" ;;
        cert_issuer) printf '%s' "Издатель:        %s" ;;
        cert_valid) printf '%s' "Действителен до: %s (осталось дней: %s)" ;;
        cert_covers) printf '%s' "Покрывает %s:  %s" ;;
        yes) printf '%s' "да" ;;
        no) printf '%s' "нет" ;;
        cert_le_managed) printf '%s' "Let's Encrypt:    да, обновляется автоматически" ;;
        cert_not_le) printf '%s' "Let's Encrypt:    нет (самоподписанный или свой). Перейти: ./panel cert letsencrypt" ;;
        cert_no_domain) printf '%s' "в %s нет корректного PANEL_DOMAIN — укажите домен панели." ;;
        cert_renew_no_certbot) printf '%s' "сертификат не от Let's Encrypt или certbot не установлен. Выпустить: ./panel cert letsencrypt" ;;
        cert_renewed) printf '%s' "Проверка обновления выполнена." ;;
        cert_fingerprint) printf '%s' "Отпечаток SHA-256: %s" ;;
    esac
}

