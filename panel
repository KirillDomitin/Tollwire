usage() {
    if [ "$lang" = ru ]; then
        cat <<'EOF'
Использование: ./panel КОМАНДА [параметры]

  backup  [--keep N] [--dir ПАПКА]
          Резервная копия базы в backups/ (права 600). Хранятся последние N (по умолчанию 14), старые удаляются.
  restore ФАЙЛ [--yes] [--no-safety-backup]
          Заменить данные панели содержимым бэкапа. Просит подтверждение (без терминала нужен --yes) и перед
          заменой делает страховочный бэкап текущих данных.
  update  [--no-backup] [--no-pull] [--no-build]
          Бэкап, затем git pull --ff-only, затем пересборка и запуск (./install.sh) с ожиданием готовности.
          --no-build — не собирать, взять образы, привезённые ./deploy/ship-images.sh.
  logs    [СЕРВИС...] [--tail N] [--no-follow]
          Логи сервисов (nginx api worker postgres redis migrate bot); по умолчанию последние 100 строк и слежение.

  cert    [status | letsencrypt [--email EMAIL] [--accept-le-terms] | renew]
          Сертификат: status — срок, издатель и отпечаток; letsencrypt — перейти на настоящий сертификат Let's Encrypt
          (ставит certbot, на секунды останавливает nginx, обновляется само); renew — проверить обновление.
  bot     enable [--no-build] | disable | key [--remote] | revoke | status | invite ARGS…
          Telegram-бот: enable — включить на этом сервере (токен от @BotFather в TELEGRAM_BOT_TOKEN или скрытым вводом);
          disable — остановить; key — заменить ключ бота (--remote — выпустить ключ для бота на другом сервере и
          показать его один раз); revoke — отозвать ключ; status — ключи и когда бот был на связи; invite — приглашения
          (invite protocols, invite create --protocol ID --days N --expires-in 7d).

В бэкап не входит .env.prod: ключ шифрования хранится отдельно от данных. Язык сообщений: PANEL_LANG=ru|en,
иначе по локали системы, по умолчанию английский.
EOF
    else
        cat <<'EOF'
Usage: ./panel COMMAND [options]

  backup  [--keep N] [--dir DIR]
          Back up the database into backups/ (mode 600). The latest N are kept (14 by default), older ones deleted.
  restore FILE [--yes] [--no-safety-backup]
          Replace the panel data with the backup. Asks for confirmation (--yes without a terminal) and takes a
          safety backup of the current data first.
  update  [--no-backup] [--no-pull] [--no-build]
          Backup, then git pull --ff-only, then rebuild and start (./install.sh) and wait until ready.
          --no-build - do not build, use the images brought by ./deploy/ship-images.sh.
  logs    [SERVICE...] [--tail N] [--no-follow]
          Service logs (nginx api worker postgres redis migrate bot); the last 100 lines and follow by default.

  cert    [status | letsencrypt [--email EMAIL] [--accept-le-terms] | renew]
          Certificate: status - expiry, issuer and fingerprint; letsencrypt - switch to a real Let's Encrypt certificate
          (installs certbot, stops nginx for seconds, renews itself); renew - check the renewal.
  bot     enable [--no-build] | disable | key [--remote] | revoke | status | invite ARGS...
          Telegram bot: enable - turn it on here (the @BotFather token in TELEGRAM_BOT_TOKEN or hidden input);
          disable - stop it; key - replace the bot key (--remote - issue a key for a bot on another server and show
          it once); revoke - revoke a key; status - keys and when the bot was last seen; invite - invitations
          (invite protocols, invite create --protocol ID --days N --expires-in 7d).

.env.prod is not part of the backup: the encryption key is kept apart from the data. Message language:
PANEL_LANG=ru|en, otherwise the system locale, English by default.
EOF
    fi
}

compose=(docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE")

preflight() {
    command -v docker > /dev/null 2>&1 || die "$(t no_docker)"
    docker info > /dev/null 2>&1 || die "$(t docker_unreachable)"
    docker compose version > /dev/null 2>&1 || die "$(t no_compose)"
    if bot_compose_old; then die "$(t bot_old_compose "$bot_compose_version")"; fi
    [ -f "$ENV_FILE" ] || die "$(t no_env "$ENV_FILE")"
    [ -f "$COMPOSE_FILE" ] || die "$(t no_compose_file "$COMPOSE_FILE")"
}

require_postgres() {
    [ -n "$("${compose[@]}" ps -q postgres 2> /dev/null)" ] || die "$(t postgres_down)"
}

# Дамп формата pg_dump -Fc начинается с сигнатуры PGDMP: так отличаем его от пустого файла и от мусора.
is_dump() { [ "$(head -c 5 "$1" 2> /dev/null)" = PGDMP ]; }

# Создаёт бэкап и кладёт путь в backup_path. Файл появляется под своим именем только целым и проверенным.
backup_path=""
make_backup() {
    local prefix=$1 dir=$2 stamp target n=1
    stamp=$(date +%Y%m%d-%H%M%S)
    (umask 077 && mkdir -p "$dir")
    chmod 700 "$dir" 2> /dev/null || true
    target="$dir/$prefix-$stamp.dump"
    while [ -e "$target" ]; do
        target="$dir/$prefix-$stamp-$n.dump"
        n=$((n + 1))
    done
    part_file=$(umask 077 && mktemp "$dir/.part.XXXXXX")
    # Учётные данные берутся из окружения контейнера базы: пароль не появляется ни в аргументах, ни на экране.
    "${compose[@]}" exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$part_file" \
        || die "$(t backup_failed)"
    is_dump "$part_file" || die "$(t backup_invalid)"
    chmod 600 "$part_file"
    mv "$part_file" "$target"
    part_file=""
    backup_path=$target
}

# Оставляет $2 последних обычных бэкапов в $1; страховочные (tollwire-pre-restore-…) и чужие файлы не трогает.
prune_backups() {
    local dir=$1 keep=$2 old removed=0
    old=$(ls -1t "$dir"/tollwire-[0-9]*.dump 2> /dev/null | tail -n +$((keep + 1)) || true)
    [ -n "$old" ] || return 0
    while IFS= read -r file; do
        rm -f -- "$file"
        removed=$((removed + 1))
    done <<< "$old"
    say "$(t backup_pruned "$removed" "$keep")"
}

is_number() { [[ $1 =~ ^[0-9]+$ ]]; }

cmd_backup() {
    local keep=$DEFAULT_KEEP dir=$DEFAULT_BACKUP_DIR
    while [ $# -gt 0 ]; do
        case "$1" in
            --keep)
                [ $# -ge 2 ] || die "$(t need_value --keep)"
                keep=$2
                shift 2
                ;;
            --dir)
                [ $# -ge 2 ] || die "$(t need_value --dir)"
                dir=$2
                shift 2
                ;;
            *) die "$(t unknown_option "$1")" ;;
        esac
    done
    { is_number "$keep" && [ "$keep" -ge 1 ]; } || die "$(t bad_keep)"
    preflight
    require_postgres
    make_backup tollwire "$dir"
    say "$(t backup_done "$backup_path" "$(du -h "$backup_path" | cut -f1)")"
    prune_backups "$dir" "$keep"
    say "$(t backup_key_reminder "$ENV_FILE" "$ENV_FILE")"
}

cmd_restore() {
    local file="" assume_yes=0 safety=1 answer safety_path="-"
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes)
                assume_yes=1
                shift
                ;;
            --no-safety-backup)
                safety=0
                shift
                ;;
            -*) die "$(t unknown_option "$1")" ;;
            *)
                file=$1
                shift
                ;;
        esac
    done
    [ -n "$file" ] || die "$(t restore_need_file)"
    [ -f "$file" ] || die "$(t restore_no_file "$file")"
    is_dump "$file" || die "$(t restore_not_dump "$file")"
    preflight
    require_postgres

    if [ "$assume_yes" -eq 0 ]; then
        { [ -t 0 ] && [ -t 1 ]; } || die "$(t restore_need_terminal)"
        say "$(t restore_warning "$file")"
        read -r -p "$(t restore_prompt)" answer || answer=""
        if [ "$answer" != restore ]; then
            say "$(t restore_aborted)"
            return 1
        fi
    fi

    if [ "$safety" -eq 1 ]; then
        make_backup tollwire-pre-restore "$DEFAULT_BACKUP_DIR"
        safety_path=$backup_path
        say "$(t safety_backup "$safety_path")"
    fi

    say "$(t restore_stopping)"
    "${compose[@]}" stop api worker
    # Одна транзакция: если дамп окажется негодным, база останется ровно такой, какой была.
    if ! "${compose[@]}" exec -T postgres sh -c \
        'pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists --no-owner --single-transaction' < "$file"; then
        "${compose[@]}" start api worker || true
        die "$(t restore_failed "$safety_path")"
    fi

    # Дамп мог быть снят на более старой версии: схема догоняет код до запуска api и worker.
    say "$(t restore_migrating)"
    "${compose[@]}" run --rm migrate
    PANEL_LANG=$lang ./install.sh --no-admin
    say "$(t restore_done "$file")"
}

cmd_update() {
    local do_backup=1 do_pull=1 build_args=() taken="" status
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-backup)
                do_backup=0
                shift
                ;;
            --no-pull)
                do_pull=0
                shift
                ;;
            --no-build)
                build_args=(--no-build)
                shift
                ;;
            *) die "$(t unknown_option "$1")" ;;
        esac
    done
    preflight

    # Условия для git проверяем ДО бэкапа: отказ после него был бы лишней работой.
    if [ "$do_pull" -eq 1 ]; then
        command -v git > /dev/null 2>&1 && git rev-parse --is-inside-work-tree > /dev/null 2>&1 || die "$(t update_not_git)"
        [ -z "$(git status --porcelain --untracked-files=no)" ] || die "$(t update_dirty)"
    fi

    if [ "$do_backup" -eq 1 ]; then
        require_postgres
        make_backup tollwire "$DEFAULT_BACKUP_DIR"
        taken=$backup_path
        say "$(t backup_done "$taken" "$(du -h "$taken" | cut -f1)")"
        prune_backups "$DEFAULT_BACKUP_DIR" "$DEFAULT_KEEP"
    fi

    if [ "$do_pull" -eq 1 ]; then
        say "$(t update_pulling)"
        git pull --ff-only || die "$(t update_pull_failed)"
    fi

    # После git pull ./install.sh — уже новая версия: пересборка, миграции и ожидание готовности делает он.
    status=0
    PANEL_LANG=$lang ./install.sh --no-admin ${build_args[@]+"${build_args[@]}"} || status=$?
    if [ "$status" -ne 0 ]; then
        if [ -n "$taken" ]; then
            printf '%s\n' "$(t update_failed "$taken" "$taken")" >&2
        else
            printf '%s\n' "$(t update_failed_nobackup)" >&2
        fi
        return "$status"
    fi
    say "$(t update_done)"
}

cmd_logs() {
    local tail_lines=$DEFAULT_TAIL follow=1 services=() service known
    while [ $# -gt 0 ]; do
        case "$1" in
            --tail)
                [ $# -ge 2 ] || die "$(t need_value --tail)"
                tail_lines=$2
                shift 2
                ;;
            --no-follow)
                follow=0
                shift
                ;;
            -*) die "$(t unknown_option "$1")" ;;
            *)
                services+=("$1")
                shift
                ;;
        esac
    done
    is_number "$tail_lines" || die "$(t bad_tail)"
    for service in ${services[@]+"${services[@]}"}; do
        known=0
        for candidate in $SERVICES; do
            [ "$candidate" != "$service" ] || known=1
        done
        [ "$known" -eq 1 ] || die "$(t bad_service "$service" "$SERVICES")"
    done
    preflight
    local args=(logs --tail "$tail_lines")
    [ "$follow" -eq 0 ] || args+=(-f)
    "${compose[@]}" "${args[@]}" ${services[@]+"${services[@]}"}
}

cmd_cert() {
    local sub=${1:-status}
    [ $# -eq 0 ] || shift
    case $sub in
        status) cert_status ;;
        letsencrypt) cert_letsencrypt "$@" ;;
        renew) cert_renew ;;
        *) die "$(t cert_unknown "$sub")" ;;
    esac
}

cert_status() {
    [ -f "$CERT_FILE" ] || die "$(t cert_missing "$CERT_FILE")"
    local domain days_left covers issuer
    domain=$(env_get PANEL_DOMAIN)
    issuer=$(openssl x509 -in "$CERT_FILE" -noout -issuer | sed 's/^issuer= *//')
    days_left=$(( ($(date -d "$(openssl x509 -in "$CERT_FILE" -noout -enddate | cut -d= -f2)" +%s 2> /dev/null || echo 0) - $(date +%s)) / 86400 ))
    say "$(t cert_file "$CERT_FILE")"
    say "$(t cert_issuer "$issuer")"
    say "$(t cert_valid "$(openssl x509 -in "$CERT_FILE" -noout -enddate | cut -d= -f2)" "$days_left")"
    say "$(t cert_fingerprint "$(openssl x509 -in "$CERT_FILE" -noout -fingerprint -sha256 | cut -d= -f2)")"
    if [ -n "$domain" ]; then
        covers=$(openssl x509 -in "$CERT_FILE" -noout -checkhost "$domain" 2> /dev/null || true)
        case $covers in
            *"does match"*) say "$(t cert_covers "$domain" "$(t yes)")" ;;
            *) say "$(t cert_covers "$domain" "$(t no)")" ;;
        esac
    fi
    if [[ $issuer == *"Let's Encrypt"* ]]; then say "$(t cert_le_managed)"; else say "$(t cert_not_le)"; fi
}

cert_letsencrypt() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --email)
                [ $# -ge 2 ] || die "$(t need_value --email)"
                le_email=$2
                shift 2
                ;;
            --accept-le-terms)
                le_accept=1
                shift
                ;;
            *) die "$(t unknown_option "$1")" ;;
        esac
    done
    preflight
    local domain
    domain=$(env_get PANEL_DOMAIN)
    le_public_domain "$domain" || die "$(t le_bad_domain "${domain:-?}")"
    le_consent || exit 1
    le_issue "$domain" || exit 1
    le_report_success
}

cert_renew() {
    preflight
    command -v certbot > /dev/null 2>&1 || die "$(t cert_renew_no_certbot)"
    le_prepare_root || exit 1
    # shellcheck disable=SC2086
    $le_sudo certbot renew --cert-name "$LE_CERT_NAME" || exit 1
    say "$(t cert_renewed)"
}

cmd_bot() {
    local sub=${1:-}
    [ $# -eq 0 ] || shift
    case $sub in
        "" | -h | --help | help)
            say "$(t bot_usage)"
            return 0
            ;;
        enable | disable | key | revoke | status | invite) ;;
        *) die "$(t bot_unknown_sub "$sub")" ;;
    esac
    preflight
    # tty: терминал нужен скриптам, которые показывают секрет только человеку (invite create без --raw);
    # без терминала compose run без -T отказался бы работать.
    local tty=()
    bot_terminal || tty=(-T)
    case $sub in
        enable)
            # --no-build: образ бота уже привезён ./deploy/ship-images.sh, собирать его не нужно.
            [ "${1:-}" != --no-build ] || bot_build=0
            bot_compose_ok || die "$(t bot_old_compose "${bot_compose_version:-?}")"
            bot_enable || exit 1
            ;;
        disable) bot_disable ;;
        key)
            if [ "${1:-}" = --remote ]; then
                bot_key_remote || exit 1
            else
                bot_rotate_key || exit 1
            fi
            ;;
        revoke) bot_revoke || exit 1 ;;
        status) "${compose[@]}" run --rm ${tty[@]+"${tty[@]}"} -e "PANEL_LANG=$lang" api python -m scripts.bot_key list ;;
        invite) "${compose[@]}" run --rm ${tty[@]+"${tty[@]}"} -e "PANEL_LANG=$lang" api python -m scripts.bot_invite "$@" ;;
    esac
}

main() {
    local command=${1:-}
    case $command in
        backup | restore | update | logs | cert | bot)
            shift
            "cmd_$command" "$@"
            ;;
        "" | -h | --help | help)
            usage
            ;;
        *)
            usage >&2
            die "$(t unknown_command "$command")"
            ;;
    esac
}

# Вызов и exit — в одной строке: bash читает скрипт по мере выполнения, а `update` делает git pull, который может
# подменить этот файл. Всё нужное уже прочитано (тело — в функциях), следующую строку из нового файла bash не возьмёт.
main "$@"; exit $?
