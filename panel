        need_value) printf '%s' "%s needs a value." ;;
        no_docker) printf '%s' "Docker not found." ;;
        docker_unreachable) printf '%s' "cannot talk to Docker: the daemon is not running or you lack permission." ;;
        no_compose) printf '%s' "the Docker Compose plugin ('docker compose') was not found." ;;
        no_env) printf '%s' "%s not found: install the panel with ./install.sh first." ;;
        no_compose_file) printf '%s' "%s not found: run ./panel from the repository root." ;;
        postgres_down) printf '%s' "the database container is not running. Start the panel first: ./install.sh" ;;
