DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vpn_panel
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change_me_generate_random_string
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=2592000
ENCRYPTION_KEY=change_me_generate_random_string # generate (uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
LOG_LEVEL=info
LOG_FORMAT=text  # text — читаемо локально; json — для прода (в docker-compose.prod.yml задан json)
# Планировщик в воркере (секунды; 0 — правило выключено)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15
ACCESS_RULES_INTERVAL_SECONDS=60
SESSION_CLEANUP_INTERVAL_SECONDS=3600
HEALTH_INTERVAL_SECONDS=600
SYNC_INTERVAL_SECONDS=3600
STALE_JOBS_INTERVAL_SECONDS=300
STALE_JOB_TIMEOUT_SECONDS=1800
REQUEUE_INTERVAL_SECONDS=300
REQUEUE_PENDING_AFTER_SECONDS=300
RETENTION_INTERVAL_SECONDS=86400
JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Локально API работает по http — cookie без флага Secure. В проде не задавать (по умолчанию true).
COOKIE_SECURE=false
# --- Rate limiting (Redis; окна в секундах) ---
LOGIN_IP_MAX_ATTEMPTS=10         # любых попыток входа с одного IP за окно
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_MAX_FAILURES=5             # неудач в одну учётку с одного IP → этот IP закрыт на LOGIN_LOCK_SECONDS
LOGIN_EMAIL_MAX_FAILURES=50      # неудач в одну учётку со всех IP → учётка закрыта целиком
LOGIN_LOCK_SECONDS=900
REFRESH_IP_MAX_ATTEMPTS=30
REFRESH_IP_WINDOW_SECONDS=60

# --- Bot API (Telegram-бот, /api/v1/bot/*; окна в секундах) ---
BOT_AUTH_IP_MAX_FAILURES=30         # неудач авторизации (нет/неверный/отозванный ключ) с одного IP за окно
BOT_AUTH_IP_WINDOW_SECONDS=60
BOT_KEY_MAX_REQUESTS=300            # всех запросов с одного ключа за окно
BOT_KEY_WINDOW_SECONDS=60
BOT_REGISTRATIONS_MAX=10            # регистраций с одного ключа за окно
BOT_REGISTRATIONS_WINDOW_SECONDS=60

# --- Страница конфига (ссылки, которые выдаёт бот; открывается без входа) ---
# Публичный адрес панели в ссылках: https://домен[:порт], без пути. Пусто - берётся PANEL_DOMAIN и HTTPS_PORT.
# За внешним reverse proxy задайте явно (http допустим только для localhost). Пусто и там и там - ссылок нет.
PUBLIC_URL=
PUBLIC_CONFIG_IP_MAX_FAILURES=20            # неудач (неверный токен) с одного IP за окно
PUBLIC_CONFIG_IP_FAILURE_WINDOW_SECONDS=600
PUBLIC_CONFIG_IP_MAX_REQUESTS=60            # всех запросов страницы с одного IP за окно
PUBLIC_CONFIG_IP_REQUEST_WINDOW_SECONDS=60

# --- Мониторинг серверов (замер по SSH, только чтение; 0 — правило выключено) ---
METRICS_INTERVAL_SECONDS=60
METRICS_ROLLUP_INTERVAL_SECONDS=300
METRICS_RAW_RETENTION_DAYS=7        # поминутные замеры
METRICS_HOURLY_RETENTION_DAYS=90    # почасовая свёртка (среднее и пик)
METRICS_CONCURRENCY=5               # серверов одновременно
