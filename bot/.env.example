# Настройки Telegram-бота на отдельном сервере (вариант «другой сервер»). Обычно этот файл создаёт install-bot.sh
# (права 0600). Не коммитить: здесь токен Telegram и ключ бота.

# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ключ бота, выпущенный на сервере панели: ./panel bot key --remote
BOT_API_KEY=
# Адрес панели: только https (бот не отправляет ключ по открытому http).
PANEL_URL=https://panel.example.com
# Свой (самоподписанный) сертификат панели; внутри контейнера он лежит в /certs. Для Let's Encrypt не нужен.
# PANEL_CA_FILE=/certs/panel-ca.pem
LOG_LEVEL=INFO
