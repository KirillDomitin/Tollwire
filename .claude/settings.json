{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/ruff_on_edit.py", "timeout": 30 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./frontend/package-lock.json)",
      "Read(./uv.lock)",
      "Read(./frontend/openapi.json)",
      "Read(./frontend/src/assets/**)"
    ],
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ]
  }
}
